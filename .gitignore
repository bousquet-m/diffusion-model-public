# Data (external, read-only — never tracked)
# NOTE: anchored to repo root so it does not swallow the insite_diff/data package.
*.extxyz
*.xyz
*.traj
/data/

# Model weights / checkpoints / logs
*.model
*.pt
*.ckpt
checkpoints/
runs/
outputs/
logs/

# Cluster run pulls (rsync'd back from /scratch/.../diffusion/gen{N}/ for local analysis).
# These contain whole nested clones + checkpoints — never track them.
/gen[0-9]/
/gen[0-9][0-9]/
*.png
!docs/**/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Env / editor
.venv/
venv/
.env
.DS_Store
*.swp
.vscode/
.idea/

# Local Claude Code settings (machine-specific paths, personal perms)
.claude/settings.local.json
