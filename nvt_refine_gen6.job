#!/bin/bash
# MACE NVT post-refinement for gen6 (HANDOFF step 4). The gen6 structures are mildly
# under-coordinated (worst at low mask_frac); a short NVT MD + 0 K quench should let
# under-coordinated atoms find neighbors and drop the energy toward the reference.
#
# NVT ONLY — no NPT. This potential (scan_v3_swa) is not reliable for the stress/cell
# dynamics NPT needs, so the generated box is held fixed. nvt_refine enforces this (the
# Langevin thermostat never touches the cell; a test asserts the cell is unchanged).
#
# Short temperature line-search so we see the effect and its T-dependence. Compare each
# run's post-NVT coordination/energy to the pre-NVT (gen) columns in the SAME row:
#   python scripts/collect_langevin_tuning.py outputs/nvt_gen6
# NVT works if d_coord_nvt is nearer 0 than d_coord and E_nvt-ref < E gen-ref. Too high a T
# will restructure (coordination overshoots / diversity meaning changes) — that is the knob
# this line-search is meant to find.
#
# Cost note: NVT is MACE-heavy — nvt_steps + relax_steps force evals PER generated frame.
# Kept small here (--n-structures 2 --n-seeds 3 --fractions 0.1,1.0, 150 MD + 150 quench).
#
#   cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
#   git pull                       # needs nvt_refine + sweep --nvt-* flags
#   mkdir -p logs
#   sbatch nvt_refine_gen6.job
#SBATCH --job-name=insite-nvt-gen6
#SBATCH --account=pi-gagalli
#SBATCH --partition=gagalli-gpu
#SBATCH --qos=gagalli-gpu
#SBATCH --constraint=A100
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --mail-user=bousquet@uchicago.edu
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
module load python/miniforge-25.3.0 cuda/12.2 cudnn mkl/2024.2
source activate /project2/gagalli/bousquet/envs/insite-diff

cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
export PYTHONPATH=.
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

CKPT=checkpoints/gen6/final.pt
COMMON="--config configs/gen6.yaml --checkpoint $CKPT --fractions 0.1,1.0 \
        --n-structures 2 --n-seeds 3 --train-sample 40 --mace \
        --nvt-steps 150 --nvt-timestep 1.0"

echo "host=$(hostname)"; echo "code: $(git rev-parse --short HEAD)"
python -c "import torch; print('cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"

for T in 300 500 800; do
    echo; echo "################ NVT T=${T}K ################"
    python scripts/sweep.py $COMMON --nvt-temp "$T" --out "outputs/nvt_gen6/T${T}"
done

echo; echo "[nvt] done. read: python scripts/collect_langevin_tuning.py outputs/nvt_gen6"
