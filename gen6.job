#!/bin/bash
# gen6 training: VE recipe + the uvu message tensor-product fix (see configs/gen6.yaml).
#
# Job scripts live in the repo on purpose. They used to exist only on the cluster and were
# hand-edited per generation, which is how sweep.job ended up pointing at the gen2 tree with
# a `vp` config while sweeping a `ve` checkpoint. Clone -> sbatch; do not hand-edit paths.
#
#   cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
#   mkdir -p logs            # REQUIRED before submit: --output cannot create the dir
#   sbatch gen6.job
#
# Runtime: gen5 took ~20 h for 150k steps with the old FullyConnectedTensorProduct. gen6 is
# 30k steps with ~100x cheaper fwd+bwd, so expect minutes, not hours. 4 h is slack, not a
# forecast — if this is still running after ~1 h, something is wrong.
#SBATCH --job-name=insite-gen6
#SBATCH --account=pi-gagalli
#SBATCH --partition=gagalli-gpu
#SBATCH --qos=gagalli-gpu
#SBATCH --constraint=A100
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks-per-node=1          # ONE trainer process (not 4: srun x4 clobbers one checkpoint)
#SBATCH --cpus-per-task=8            # threads for graph/analysis
#SBATCH --mem=32G
#SBATCH --mail-user=bousquet@uchicago.edu
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
module load python/miniforge-25.3.0 cuda/12.2 cudnn mkl/2024.2
source activate /project2/gagalli/bousquet/envs/insite-diff

cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
export PYTHONPATH=.
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

echo "host=$(hostname)"
python -c "import torch; print('cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"
python scripts/train.py --config configs/gen6.yaml
