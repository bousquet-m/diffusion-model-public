#!/bin/bash
# Langevin knob tuning for gen6 (HANDOFF step 3). The gen6 sweep passed but generated
# structures are mildly UNDER-relaxed / UNDER-coordinated — worst at low mask_frac
# (coord 4.88 vs ref 5.42 at frac 0.016; energies +28..+102 meV/atom above MD). These are
# sampling-time knobs, so this needs NO retraining — it reuses checkpoints/gen6/final.pt.
#
# Two line-searches, not a full grid, so each result is interpretable:
#   A. refine_steps  {100(base), 500, 2000}  — final no-external-noise descent onto the
#      manifold; the most direct lever for under-RELAXATION.
#   B. step_lr       {2e-5(base), 5e-5, 1e-4} — per-step movement; tests whether under-
#      COORDINATION is under-equilibration at each sigma. (base 100/2e-5 shared, run once.)
#
# Objective: --fractions 0.1,1.0. Low frac is where the symptom is worst AND is the
# surface-relevant geometry (small generated region in fixed context); 1.0 is the harshest
# pure-generation case. Small n keeps it fast; --mace gives the energy tell.
#
# READ: compare each run's coord gen/ref and E/atom gen-ref to the base run. Better =
# coord closer to ref and |E gen - ref| smaller, WITHOUT multi-seed spread collapsing
# (that would mean the knobs traded diversity for relaxation — a bad trade).
#
#   cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
#   git pull                       # needs the --langevin-* / --refine-steps flags
#   mkdir -p logs
#   sbatch tune_langevin_gen6.job
#   # then: python scripts/collect_langevin_tuning.py outputs/tune_gen6   (see below)
#SBATCH --job-name=insite-tune-gen6
#SBATCH --account=pi-gagalli
#SBATCH --partition=gagalli-gpu
#SBATCH --qos=gagalli-gpu
#SBATCH --constraint=A100
#SBATCH --time=06:00:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --mail-user=bousquet@uchicago.edu
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
module load python/miniforge-25.3.0 cuda/12.2 cudnn mkl/2024.2
source activate /project2/gagalli/bousquet/envs/insite-diff

cd /scratch/midway3/bousquet/diffusion/gen6/diffusion-model-public
export PYTHONPATH=.
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

CKPT=checkpoints/gen6/final.pt
COMMON="--config configs/gen6.yaml --checkpoint $CKPT --fractions 0.1,1.0 \
        --n-structures 2 --n-seeds 3 --train-sample 40 --mace"

echo "host=$(hostname)"; echo "code: $(git rev-parse --short HEAD)"
python -c "import torch; print('cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"

run () {  # name  extra-flags...
    local name="$1"; shift
    echo; echo "################ $name ################"
    python scripts/sweep.py $COMMON --out "outputs/tune_gen6/$name" "$@"
}

# baseline (config values: step_lr 2e-5, refine 100)
run base
# A. refine_steps line-search
run refine500   --refine-steps 500
run refine2000  --refine-steps 2000
# B. step_lr line-search
run lr5e-5      --langevin-step-lr 5e-5
run lr1e-4      --langevin-step-lr 1e-4

echo; echo "[tune] done. summaries under outputs/tune_gen6/*/"
