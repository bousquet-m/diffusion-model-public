#!/bin/bash
# gen5 physical verdict: mobile-restricted In-O RDF / coordination / bond + MACE energies
# across the mask_frac ladder. Compare against the gen2/gen3 sweep failure (bond ~2.02 vs
# ref 2.19, energies ~-1e9).
#
# Setup — gen5 was TRAINED from the gen2 tree (directory names are historical), and that
# tree still runs the old code. Clone fresh and bring only the 17 MB final.pt across:
#
#   mkdir -p /scratch/midway3/bousquet/diffusion/gen5
#   cd /scratch/midway3/bousquet/diffusion/gen5
#   git clone -b amorphous-score-diffusion \
#       https://github.com/bousquet-m/diffusion-model-public.git
#   cd diffusion-model-public
#   mkdir -p logs checkpoints/gen5          # REQUIRED: --output cannot create logs/
#   cp /scratch/midway3/bousquet/diffusion/gen2/diffusion-model-public/checkpoints/gen5/final.pt \
#      checkpoints/gen5/
#   sbatch sweep_gen5.job
#
# The gen5 checkpoint predates model.tp_mode, so it rebuilds as tp_mode="fc" — the
# architecture it was trained with. That is the schema default and is verified by test.
#
# --config MUST be gen5.yaml, never base.yaml: sweep.py reads diffusion.type from the
# config, not the checkpoint, so a vp config here would silently run the DDPM sampler on
# this VE model. See HANDOFF "SWEEP FOOTGUN".
#
# Runtime: ~4 h. gen5 is the old FullyConnectedTensorProduct model (~26 ms/forward on an
# A100 x 546k forwards). A gen6 (uvu) sweep is ~50x cheaper.
#
# CANARY FIRST — do not burn 4 h to find a crash. ~2-3 min, exercises every stage
# (ve_inpaint on CUDA, RDF/coordination/SOAP, MACE, writers):
#   python scripts/sweep.py --config configs/gen5.yaml --checkpoint checkpoints/gen5/final.pt \
#       --fractions 1.0 --n-structures 1 --n-seeds 1 --train-sample 20 \
#       --out outputs/canary_gen5 --mace
#SBATCH --job-name=insite-sweep-gen5
#SBATCH --account=pi-gagalli
#SBATCH --partition=gagalli-gpu
#SBATCH --qos=gagalli-gpu
#SBATCH --constraint=A100
#SBATCH --time=08:00:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8            # threads for graph/analysis
#SBATCH --mem=32G
#SBATCH --mail-user=bousquet@uchicago.edu
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
module load python/miniforge-25.3.0 cuda/12.2 cudnn mkl/2024.2
source activate /project2/gagalli/bousquet/envs/insite-diff

cd /scratch/midway3/bousquet/diffusion/gen5/diffusion-model-public
export PYTHONPATH=.
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

echo "host=$(hostname)"
python -c "import torch; print('cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"
python scripts/sweep.py --config configs/gen5.yaml --checkpoint checkpoints/gen5/final.pt \
    --n-structures 3 --n-seeds 10 --out outputs/sweep_gen5 --mace
