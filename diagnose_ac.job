#!/bin/bash
# a-C data-sufficiency verdict — the pivotal check for training on only 10 structures.
#
# diagnose.py predicts eps across the sigma ladder and reports, at each sigma, cos(eps_hat,eps)
# and the reconstructed x0 RMSD. A working VE model keeps cos high and x0_RMSD small at ALL
# sigma (no dead zone). For a-C the specific worry is DATA VOLUME: with 10 snapshots and a
# broad distribution, a mid-sigma dead zone (cos collapsing, x0_RMSD ballooning) means the
# model cannot resolve the distribution from so few structures -> GET MORE DATA before sampling.
# This verdict is independent of the sampler.
#
# gen6 (In2O3, plentiful data) reference shape to compare against: cos peaks ~0.88 mid-ladder,
# ~0.52 at sigma_max, x0_RMSD small everywhere. a-C need not match those numbers, but it must
# show the same SHAPE (no dead zone). Low-sigma cos falloff is benign (true score ~0 there).
#
#   cd /scratch/midway3/bousquet/diffusion/amorphous-carbon/diffusion-model-public
#   git pull
#   mkdir -p logs
#   sbatch diagnose_ac.job
#SBATCH --job-name=insite-diagnose-ac
#SBATCH --account=pi-gagalli
#SBATCH --partition=gagalli-gpu
#SBATCH --qos=gagalli-gpu
#SBATCH --constraint=A100
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --mail-user=bousquet@uchicago.edu
#SBATCH --mail-type=END,FAIL
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
module load python/miniforge-25.3.0 cuda/12.2 cudnn mkl/2024.2
source activate /project2/gagalli/bousquet/envs/insite-diff

cd /scratch/midway3/bousquet/diffusion/amorphous-carbon/diffusion-model-public
export PYTHONPATH=.
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-8}

STRUCT=/scratch/midway3/bousquet/diffusion/aC/aC.extxyz
REPEATS=32          # a-C cells are small; 32 draws beats down the per-sigma noise cheaply

echo "host=$(hostname)"
python -c "import torch; print('cuda:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"
echo "code: $(git rev-parse --short HEAD)"

# Diagnose on a held-out snapshot (frame 9 = ac_325_10, in the val split under seed 0) and,
# for contrast, a training snapshot (frame 0). A big train-vs-val gap = overfitting the 10.
echo; echo "################ a-C diagnose: held-out snapshot (frame 9) ################"
python scripts/diagnose.py --checkpoint checkpoints/ac/final.pt \
    --structure "$STRUCT" --frame 9 --device cuda --repeats "$REPEATS"

echo; echo "################ a-C diagnose: training snapshot (frame 0) ################"
python scripts/diagnose.py --checkpoint checkpoints/ac/final.pt \
    --structure "$STRUCT" --frame 0 --device cuda --repeats "$REPEATS"
